{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAPE",
  "version": "0.2.0",
  "identifier": "dev.openape.desktop",
  "build": {
    "frontendDist": "ui-shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenAPE",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
